createdAt → createTime
_id → id

// 表格配置
dataIndex: 'createTime', // 之前是 'createdAt'
rowKey: 'id', // 之前是 '_id'

// 操作按钮
navigate(`/detail/${record.id}`) // 之前是 record._id
